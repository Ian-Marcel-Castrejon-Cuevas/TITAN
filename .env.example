# Copy this file to .env.local or .env and fill in your local values only.
# Never commit real credentials to the repository.

# PostgreSQL
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# Backend and application URLs
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_APP_URL=

# Authentication secrets
JWT_SECRET=
SESSION_SECRET=

# Local demo mode: uses data/demo-users.json and data/demo-tickets.json
TITAN_DEMO_MODE=true

# Carven 1 SSH and status endpoint
SSH_HOST=
SSH_USER=
SSH_PASS=
SSH_PORT=22
CARVEN1_STATUS_URL=
CARVEN1_INIT_DIR=
CARVEN1_START_COMMAND=

# Carven 2 SSH and status endpoint
SSH_HOST2=
SSH_USER2=
SSH_PASS2=
SSH_PORT2=22
CARVEN2_STATUS_URL=
CARVEN2_INIT_DIR=
CARVEN2_STOP_COMMAND=
CARVEN2_RESTART_DELAY_SECONDS=3
CARVEN2_START_COMMAND=

# Carven 3 SSH and status endpoint
SSH_HOST3=
SSH_USER3=
SSH_PASS3=
SSH_PORT3=22
CARVEN3_STATUS_URL=
CARVEN3_INIT_DIR=
CARVEN3_TOMCAT_START=
CARVEN3_NFS_START=
CARVEN3_NFS_SOURCE=
CARVEN3_NFS_TARGET=

# SQL Server
SQL_USER=
SQL_PASSWORD=
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECT_TIMEOUT=5000
SQL_REQUEST_TIMEOUT=5000

# Backend server
ADMIN_DEPARTMENTS=09
PORT=5001
HOST=0.0.0.0
DEBUG=false
JWT_EXPIRATION_HOURS=8

SECURITY_WRAPPER_ENABLED=false
